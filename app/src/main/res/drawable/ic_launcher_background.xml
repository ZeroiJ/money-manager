<?xml version="1.0" encoding="utf-8"?>
<!--
  Money Manager — iOS Liquid Glass app icon background
  Adaptive icon background layer (108dp x 108dp)
  Design: iOS system-blue → purple linear gradient with top glass sheen
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base gradient: iOS blue (#0A84FF) → purple (#5856D6) -->
    <path android:pathData="M0,0h108v108h-108z">
        <gradient
            android:type="linear"
            android:startX="0"
            android:startY="0"
            android:endX="108"
            android:endY="108"
            android:startColor="#FF0A84FF"
            android:endColor="#FF5856D6" />
    </path>

    <!-- Glass sheen: white 16% across the top half (light source from above) -->
    <path
        android:fillColor="#29FFFFFF"
        android:pathData="M0,0h108v54h-108z" />

</vector>
