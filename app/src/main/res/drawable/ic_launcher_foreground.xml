<?xml version="1.0" encoding="utf-8"?>
<!--
  Money Manager — iOS Liquid Glass app icon foreground
  Adaptive icon foreground layer (108dp x 108dp, safe zone 72dp centered)
  Design: clean white ₹ (Rupee) glyph centered, no ornament — iOS-style flat
  glyph on the gradient background layer
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      ₹ Rupee Symbol — precise geometric construction
      Based on Unicode ₹ (U+20B9): two horizontal bars, vertical left stem, curved top-right, diagonal slash

      Working in 108x108 viewport. Symbol fits in ~40x52 units centered at (54,54).
      Left edge: x=32, right edge: x=76, top: y=28, bottom: y=80
    -->

    <!-- Top horizontal bar (the topmost of the two parallel bars) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,28 L76,28 L76,34 L32,34 Z" />

    <!-- Second horizontal bar (lower parallel bar) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,40 L70,40 L70,46 L32,46 Z" />

    <!-- Left vertical stem (goes all the way from top to bottom) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,28 L38,28 L38,80 L32,80 Z" />

    <!--
      Top-right arc (the 'P' bowl of ₹):
      Approximated with straight segments. Goes from top-right of vertical stem,
      curves right and down to meet the second bar height.
      Using a path approximation for the rounded bowl.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M38,28
            L62,28
            Q76,28 76,37
            Q76,46 62,46
            L38,46
            L38,40
            L62,40
            Q70,40 70,37
            Q70,34 62,34
            L38,34
            Z" />

    <!-- Diagonal slash: from right side of second bar down to bottom-left -->
    <!-- Goes from approximately (70, 43) down-left to (38, 80) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M58,46 L76,46 L44,80 L26,80 Z" />

</vector>
