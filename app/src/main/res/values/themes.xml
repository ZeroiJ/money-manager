<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MoneyManager" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Launch background matches the app (no white flash). The
             windowSplashScreen* attrs apply on API 31+ and are ignored below. -->
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
